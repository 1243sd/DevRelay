# Copy to .env; .env is read by start scripts via node --env-file (Node 20.6+) or shell export
HOST=127.0.0.1
PORT=3210
API_TOKEN=replace-with-long-random-secret
PROJECT_ROOT=/absolute/path/to/your/git/project
DATA_DIR=./data
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1
PI_BIN=pi
PI_PROVIDER=google
PI_MODEL=
MAX_RETRIES=3
PI_TIMEOUT_MS=1800000
TEST_TIMEOUT_MS=300000
# Trusted operator setting; NEVER supplied per task via HTTP
TEST_COMMAND=npm test && npm run build
# Optional: only pass the *named* secrets necessary for your selected development agent.
# OPENAI_API_KEY is never passed to agents by default.
AGENT_ENV_ALLOWLIST=
# Optional testing/mock OpenAI-compatible endpoint
# OPENAI_BASE_URL=http://127.0.0.1:9999/v1
